<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for Messaging Graph.app, and nothing else.

  allow-unsigned-executable-memory: Python's ctypes, cffi (under cryptography)
    and PyObjC build small call trampolines at run time with libffi. Without
    this the hardened runtime refuses them and the app dies on launch.
  automation.apple-events: "Check privacy in Terminal…" asks Terminal to run
    `mg doctor`. macOS still asks you first; this only lets it ask.

  Deliberately absent: the App Sandbox (it would wall the app off from
  ~/Library/Messages, which Full Disk Access cannot reach into a sandbox),
  disable-library-validation (every library is signed with the same identity),
  allow-jit, and get-task-allow (notarization refuses it).
  Full Disk Access is not an entitlement at all: the person grants it in System
  Settings, and macOS files the grant under the bundle id and signature.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
